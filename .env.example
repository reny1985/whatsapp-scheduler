# Base de datos (Railway lo inyecta automáticamente como DATABASE_URL)
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# JWT — usa una cadena aleatoria larga en producción
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-una-clave-segura-aleatoria

# Evolution API
EVOLUTION_API_URL=https://tu-evolution.up.railway.app
EVOLUTION_API_KEY=tu-api-key-de-evolution

# URL pública de este servicio (para que Evolution API descargue archivos adjuntos)
BASE_PUBLIC_URL=https://tu-app.up.railway.app

# Directorio de uploads — en Railway apunta al Volume montado
UPLOAD_DIR=/data/uploads
